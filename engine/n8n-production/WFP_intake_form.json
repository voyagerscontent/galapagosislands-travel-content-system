      "id": "form-trigger",
      "name": "Start — Pick Pillar",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "galapagos-new-page-form"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appNkUL50eF601ejN"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tblUgxSGGfeJIL5GD"
        },
        "filterByFormula": "=AND( OR({Status} = BLANK(), {Status} = 'Backlog'), {Pillar} = '{{ $('Start — Pick Pillar').item.json.Pillar }}', {Draft Content} = BLANK(), {Polished Content} = BLANK(), {Published URL} = BLANK(), {Publish Status} = BLANK() )",
        "returnAll": true,
        "options": {}
      },
      "id": "form-list-pages",
      "name": "List Available Pages",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        220,
        0
      ],
      "credentials": {
        "airtableTokenApi": {
          "id": "mITfEGdTPqCCNrsT",
          "name": "Airtable API - Weboptimizer"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\n// Build page-2 dynamically. Keyword filtering happens HERE (not in the Airtable query) so a\n// too-narrow keyword can never dead-end the form: if it matches nothing we show all pillar\n// pages. Normalize hyphens/spaces so \"3 night\" matches \"3-Night\". Encode the record id at the\n// end of each option so we can parse it back after submit.\nconst norm = s => String(s || '').toLowerCase().replace(/[-–—_/]/g, ' ').replace(/\\s+/g, ' ').trim();\nconst rows = $input.all().filter(r => r.json && r.json.id);\nconst kwRaw = String(($('Start — Pick Pillar').first().json['Keyword filter']) || '').trim();\nconst kw = norm(kwRaw);\nlet matched = rows, note = '';\nif (kw) {\n  const f = rows.filter(r => norm(r.json['Meta Title']).includes(kw));\n  if (f.length) { matched = f; note = ` matching “${kwRaw}”`; }\n  else { note = ` — nothing matched “${kwRaw}”, so showing all ${rows.length} pages in this pillar`; }\n}\nconst options = matched.map(r => `${String(r.json['Meta Title'] || '(untitled)').replace(/\\s+/g, ' ').trim()}  ·  ${r.json.id}`);\nconst pageField = options.length\n  ? { fieldLabel: 'Page to produce', fieldType: 'dropdown', requiredField: true, fieldOptions: options }\n  : { fieldLabel: 'Page to produce', fieldType: 'dropdown', requiredField: true,\n      fieldOptions: ['— no planned pages left in this pillar —'] };\nconst def = [\n  pageField,\n  { fieldLabel: 'CTA Brand', fieldType: 'dropdown', requiredField: true,\n    fieldOptions: ['Voyagers Travel', 'Latin Trails'] },\n];\nreturn [{ json: { formDef: JSON.stringify(def), count: options.length, note } }];\n"
      },
      "id": "form-build-dd",
      "name": "Build Page Dropdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "page",
        "defineForm": "json",
        "jsonOutput": "={{ $json.formDef }}",
        "options": {
          "formTitle": "Choose the page to produce",
          "formDescription": "={{ $json.count }} planned pages{{ $json.note }}. Pick one and confirm the CTA brand.",
          "buttonLabel": "Send to production"
        }
      },
      "id": "form-pick-page",
      "name": "Pick the Page",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst sel = String($json['Page to produce'] || '');\nconst m = sel.match(/(rec[0-9A-Za-z]{14})\\s*$/);\n// Guard: the empty-pillar placeholder has no record id — never fire intake on it.\nif (!m) throw new Error('No real page was selected. Please reopen the form and choose a page from the list.');\nreturn [{ json: { recordId: m[1], ctaBrand: String($json['CTA Brand'] || ''), selection: sel } }];\n"
      },
      "id": "form-resolve",
      "name": "Resolve Selection",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appNkUL50eF601ejN"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tblUgxSGGfeJIL5GD"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "id"
          ],
          "value": {
            "id": "={{ $json.recordId }}",
            "Status": "Backlog",
            "CTA Brand": "={{ $json.ctaBrand }}",
            "Draft Content": "",
            "Humanized Content": "",
            "Polished Content": "",
            "Truth Check Notes": "",
            "Audit Notes": "",
            "Last Error": "",
            "Burstiness Retries": "={{ 0 }}",
            "Attempt Count": "={{ 0 }}"
          }
        },
        "options": {
          "typecast": true
        }
      },
      "id": "form-queue",
