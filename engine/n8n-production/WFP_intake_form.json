                  },
                  {
                    "option": "Itineraries"
                  },
                  {
                    "option": "Planning"
                  },
                  {
                    "option": "Activities"
                  },
                  {
                    "option": "Visitor Sites"
                  },
                  {
                    "option": "FAQ"
                  },
                  {
                    "option": "Conservation"
                  },
                  {
                    "option": "Blog"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "CTA Brand",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Voyagers Travel"
                  },
                  {
                    "option": "Latin Trails"
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "path": "new-page",
          "buttonLabel": "Find page",
          "appendAttribution": false,
          "ignoreBots": true
        }
      },
      "id": "form-trigger",
      "name": "New Page Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "galapagos-new-page-form"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appNkUL50eF601ejN"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tblUgxSGGfeJIL5GD"
        },
        "filterByFormula": "=AND( OR({Status} = BLANK(), {Status} = 'Backlog'), {Draft Content} = BLANK(), {Polished Content} = BLANK(), {Published URL} = BLANK(), {Publish Status} = BLANK(), OR( '{{ $('New Page Form').item.json.Pillar }}' = 'Any pillar (search all)', {Pillar} = '{{ $('New Page Form').item.json.Pillar }}' ) )",
        "returnAll": true,
        "options": {}
      },
      "id": "form-list",
      "name": "List Available Pages",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        220,
        0
      ],
      "credentials": {
        "airtableTokenApi": {
          "id": "mITfEGdTPqCCNrsT",
          "name": "Airtable API - Weboptimizer"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nconst norm = s => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '')\n  .toLowerCase().replace(/[-–—_/]/g, ' ').replace(/\\s+/g, ' ').trim();\nconst trig = $('New Page Form').first().json;\nconst kwRaw = String(trig['Page title'] || '').trim();\nconst cta = String(trig['CTA Brand'] || '');\nconst kw = norm(kwRaw);\nconst rows = $input.all().filter(r => r.json && r.json.id)\n  .map(r => ({ id: r.json.id, title: String(r.json['Meta Title'] || '(untitled)').replace(/\\s+/g,' ').trim() }));\nrows.forEach(r => r.n = norm(r.title));\nif (!kw) return [{ json: { status: 'none', retryMsg: 'Please type part of the page title, then submit again.' } }];\nconst exact = rows.filter(r => r.n === kw);\nconst starts = rows.filter(r => r.n.startsWith(kw));\nconst contains = rows.filter(r => r.n.includes(kw));\nlet pick = null, pool = null;\nif (exact.length === 1) pick = exact[0];\nelse if (exact.length > 1) pool = exact;\nelse if (starts.length === 1) pick = starts[0];\nelse if (contains.length === 1) pick = contains[0];\nelse pool = contains;\nif (pick) return [{ json: { status: 'one', recordId: pick.id, title: pick.title, ctaBrand: cta } }];\n// none / ambiguous -> render a CLICKABLE list. Each match links back to the form pre-filled\n// with that EXACT title (n8n prefills fields from query params), so one click -> exact match\n// -> confirm -> produce, instead of retyping.\nconst esc = t => String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\nconst enc = encodeURIComponent;\nconst link = t => 'https://voyagerscontent.app.n8n.cloud/form/new-page?Page%20title=' + enc(t)\n  + '&Pillar=' + enc('Any pillar (search all)') + '&CTA%20Brand=' + enc(cta || 'Voyagers Travel');\nif (!pool || pool.length === 0)\n  return [{ json: { status: 'none', retryHtml: `<div style=\"font-size:15px;line-height:1.5\"><p>No planned page matched “${esc(kwRaw)}”.</p><p>Go back and try different or fewer words. (Already-published pages are handled by the separate optimize pipeline.)</p></div>` } }];\nconst items = pool.slice(0, 40).map(r => `<li style=\"margin:7px 0\"><a href=\"${link(r.title)}\">${esc(r.title)}</a></li>`).join('');\nconst more = pool.length > 40 ? `<p>…and ${pool.length - 40} more — type more of the title to narrow.</p>` : '';\nreturn [{ json: { status: 'many', retryHtml: `<div style=\"font-size:15px;line-height:1.5\"><p><b>${pool.length}</b> planned pages match “${esc(kwRaw)}”. Click the exact page you want to produce:</p><ul>${items}</ul>${more}</div>` } }];\n"
      },
      "id": "form-match",
      "name": "Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "one"
            }
          ]
        }
      },
      "id": "form-found",
      "name": "Found one?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        640,
        0
      ]
    },
    {
