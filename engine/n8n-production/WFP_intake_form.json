{
  "name": "WFP-Intake Form - GalapagosIslands.travel",
  "nodes": [
    {
      "parameters": {
        "formTitle": "New Page — GalapagosIslands.travel Production",
        "formDescription": "Queue a new page for the content pipeline. Fill this in and submit; the page runs itself through scoring, brief, draft, truth-check, humanize, polish and audit, then lands in Airtable at <b>Editor Review</b>.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Page Title",
              "fieldType": "text",
              "placeholder": "e.g. Best Time to See Whale Sharks in the Galápagos",
              "requiredField": true
            },
            {
              "fieldLabel": "Primary Keyword",
              "fieldType": "text",
              "placeholder": "e.g. galapagos whale shark season",
              "requiredField": true
            },
            {
              "fieldLabel": "Pillar",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Cruises"
                  },
                  {
                    "option": "Wildlife"
                  },
                  {
                    "option": "Islands"
                  },
                  {
                    "option": "Itineraries"
                  },
                  {
                    "option": "Planning"
                  },
                  {
                    "option": "Activities"
                  },
                  {
                    "option": "Visitor Sites"
                  },
                  {
                    "option": "FAQ"
                  },
                  {
                    "option": "Conservation"
                  },
                  {
                    "option": "Blog"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Page Type",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Guide"
                  },
                  {
                    "option": "Hub Page"
                  },
                  {
                    "option": "Pillar Page"
                  },
                  {
                    "option": "Final Answer Page"
                  },
                  {
                    "option": "Blog Post"
                  },
                  {
                    "option": "FAQ Page"
                  },
                  {
                    "option": "Island Page"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Brief / Notes",
              "fieldType": "textarea",
              "placeholder": "What should this page cover? Angle, must-include facts, audience, anything the writer needs.",
              "requiredField": true
            },
            {
              "fieldLabel": "Target Word Count",
              "fieldType": "number",
              "placeholder": "2500",
              "requiredField": true
            },
            {
              "fieldLabel": "CTA Brand",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Voyagers Travel"
                  },
                  {
                    "option": "Latin Trails"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Secondary Keywords",
              "fieldType": "text",
              "placeholder": "optional — comma separated",
              "requiredField": false
            },
            {
              "fieldLabel": "Hub Page URL",
              "fieldType": "text",
              "placeholder": "optional — the pillar hub this belongs under",
              "requiredField": false
            },
            {
              "fieldLabel": "Named Author",
              "fieldType": "text",
              "placeholder": "optional — persona byline, e.g. Juan Magallanes",
              "requiredField": false
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "new-page",
          "buttonLabel": "Queue page for production",
          "appendAttribution": false,
          "ignoreBots": true,
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "✅ Your page is queued and now in production. It will appear in Airtable under “Editor Review” when ready (typically ~15–30 minutes). You can submit another page any time."
            }
          }
        }
