          "values": [
            {
              "fieldLabel": "Page title",
              "fieldType": "text",
              "placeholder": "e.g. 3-day itinerary, honeymoon cruise, Bartolomé",
              "requiredField": true
            },
            {
              "fieldLabel": "Pillar",
              "fieldType": "dropdown",
              "defaultValue": "Any pillar (search all)",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Any pillar (search all)"
                  },
                  {
                    "option": "Cruises"
                  },
                  {
                    "option": "Wildlife"
                  },
                  {
